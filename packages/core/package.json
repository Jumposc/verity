{
  "name": "@solvir/verity-core",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Verity core: deterministic style extraction, matching and diff. Zero AI, zero IO.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "culori": "^4.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1"
  }
}
